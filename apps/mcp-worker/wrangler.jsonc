{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "verisource-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "VERISOURCE_CACHE",
      "id": "50e2a82027584c8e97ac8281522f27cf"
    }
  ],
  "triggers": {
    "crons": ["0 13 * * *"]
  }
}
