# Provider Mode: 'mock' (default local dev) or 'live'
PROVIDER_MODE=mock

# Public App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MCP_URL=http://localhost:8787/mcp

# Supabase (Leave blank in mock mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM Search Engines (Leave blank in mock mode)
GEMINI_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# Scraping (Leave blank in mock mode)
FIRECRAWL_API_KEY=

# Stripe Billing (Leave blank in mock mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Automated Hallucination Drift Alerts via Resend (Leave blank for dry-run preview mode)
RESEND_API_KEY=
ALERT_FROM_EMAIL=Verisource Watchdog <alerts@verisource.dev>

# Google Search Console Verification Meta Token (Optional if verified via Cloudflare DNS TXT)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Official MCP Registry Ed25519 Public Key for /.well-known/mcp-registry-auth (dev.verisource/mcp)
MCP_REGISTRY_PUBLIC_KEY=1Jz3uDgGEjNLR5zl3BQpjwrRwT12l9WINFNyVeNgeFs=
