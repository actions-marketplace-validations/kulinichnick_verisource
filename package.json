{
  "name": "verisource-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @verisource/web dev",
    "dev:mcp": "pnpm --filter @verisource/mcp-worker dev",
    "dev:ext": "pnpm --filter @verisource/extension dev",
    "typecheck": "pnpm --filter @verisource/core-geo build && pnpm --filter @verisource/ui build && pnpm -r typecheck",
    "test": "pnpm --filter @verisource/core-geo build && pnpm --filter @verisource/ui build && pnpm -r test",
    "build": "pnpm -r build",
    "stripe:live": "pnpm --filter @verisource/web stripe:live",
    "ops:daily": "node scripts/growth_workflows/ops-daily.mjs --send-email",
    "ops:followup": "node scripts/growth_workflows/ops-warm-followup.mjs --send-email",
    "ops:activate-free": "node scripts/growth_workflows/ops-free-activation.mjs --send-email",
    "ops:weekly": "node scripts/growth_workflows/ops-weekly.mjs",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "next": "^15.1.6",
    "typescript": "^5.7.3"
  }
}
